[Unit]
Description=Experanto Edge agent
Documentation=https://github.com/BestFab/experanto-edge-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=experanto-edge
Group=experanto-edge
ExecStart=/opt/experanto-edge/current/venv/bin/experanto-edge
Restart=always
RestartSec=10

# Hardening — the agent only needs outbound network + its own state dirs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/experanto-edge /etc/experanto-edge

[Install]
WantedBy=multi-user.target
